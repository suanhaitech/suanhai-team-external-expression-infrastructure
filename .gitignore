.vscode/

# Ruby 本地缓存
.bundle/

# 本地预览、截图和临时输出
.tmp/
tmp/
preview/
screenshots/

# 仓库内的单页模板预览是可复用设计资产，不属于本地临时预览输出
!infrastructure/
!infrastructure/html/
!infrastructure/html/templates/
!infrastructure/html/templates/single-page/
!infrastructure/html/templates/single-page/preview/
!infrastructure/html/templates/single-page/preview/**

# 交互体验页同样是引用真实组件的文档资产，截图和浏览器缓存仍放仓外
!infrastructure/html/runtime-kits/
!infrastructure/html/runtime-kits/preview/
!infrastructure/html/runtime-kits/preview/**

