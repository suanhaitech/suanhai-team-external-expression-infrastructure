{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "本地来源素材登记 v1",
  "type": "object",
  "required": ["schema_version", "tool", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"const": "html.source-assets"},
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "role", "source", "source_url", "derived_from", "transformation", "usage_rights", "caption", "sha256", "bytes", "content_type", "width", "height"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "path": {"type": "string", "minLength": 1},
          "role": {"enum": ["original", "derived"]},
          "source": {"type": "string"},
          "source_url": {"type": ["string", "null"]},
          "derived_from": {"type": ["string", "null"]},
          "transformation": {"type": "string", "minLength": 1},
          "usage_rights": {"type": "string"},
          "caption": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "content_type": {"type": "string"},
          "width": {"type": ["integer", "null"], "minimum": 0},
          "height": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
