{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTML full page plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "template_id",
          "title",
          "objective",
          "core_message"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "template_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "core_message": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "responds_to": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "slot",
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "candidate_assets": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "customization_reason": {
            "type": "string"
          },
          "acceptance_signals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "audience": {
      "type": "string"
    },
    "time_budget_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "learning_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_kind": {
      "enum": [
        "template",
        "report"
      ]
    }
  }
}
