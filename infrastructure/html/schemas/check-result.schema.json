{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suanhai.local/schemas/html/check-result.schema.json",
  "title": "HTML 检查证据 v1",
  "type": "object",
  "required": ["schema_version", "tool", "created_at", "html_sha256", "status", "checks", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "tool": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "html_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["pass", "fail", "not-run"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "not-run"]},
          "evidence": {"type": "object"}
        }
      }
    },
    "limits": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{"if": {"properties": {"html_sha256": {"type": "null"}}}, "then": {"properties": {"status": {"const": "not-run"}, "checks": {"items": {"properties": {"status": {"const": "not-run"}}}}}}}]
}
